---
import PrimaryNavigation from "../components/PrimaryNavigation.astro";
import LogoLink from "./LogoLink.astro";
import SocialLinks from "./SocialLinks.astro";
---

<footer class="site-footer padding-block-4 margin-block-10">
  <div class="container">
    <div class="flex-group align-center">
      <LogoLink />
      <PrimaryNavigation label="footer-navigation">
        <li>
          <a href="/articles">Articles</a>
        </li>
        <li>
          <a href="/about">About</a>
        </li>
        <li>
          <a href="/contact">Contact</a>
        </li>
      </PrimaryNavigation>
      <SocialLinks />
      <p class="ml-auto">© TravelFoodFun</p>
    </div>
  </div>
</footer>

<style lang="scss">
  @use "../styles/abstracts" as *;

  .flex-group {
    width: 100%;
  }

  .site-footer {
    background-color: $footer-background-color;
    color: $footer-text-color;
  }
</style>
