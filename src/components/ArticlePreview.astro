---
import FormattedDate from "../components/FormattedDate.astro";
import Tag from "../components/Tag.astro";
import type { CollectionEntry } from "astro:content";
import { createExcerpt } from "../utils/create-excerpt";

interface Props {
  article: CollectionEntry<"articles">;
  excerptLength?: number;
}

const { article, excerptLength = 0 } = Astro.props;
---

<article class="flow">
  <div class="image-container">
    <img src={article.data.imageSrc} alt={article.data.imageAlt} />
    <Tag tag={article.data.tags[0]} class="tag" />
  </div>

  <FormattedDate date={article.data.date} />
  <h2 class="fs-500 fw-bold">{article.data.title}</h2>

  {excerptLength > 0 && (
    <p>{createExcerpt(article.body).substring(0, excerptLength)}...</p>
  )}
  <p>
    <a href={`/articles/${article.id}`}>
      Read more <span class="visually-hidden">about {article.data.title}</span>
    </a>
  </p>
</article>

<style lang="scss">
  @use "../styles/abstracts" as *;

  article {
    --flow-spacer: #{$article-preview-spacing};
  }

  .image-container {
    position: relative;
  }

  .tag {
    position: absolute;
    z-index: 1;
    bottom: $article-preview-tag-offset;
    left: $article-preview-tag-offset;

    &:hover,
    &:focus {
      text-decoration: none;
    }
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: $article-preview-aspect-ratio;
    border-radius: $border-radius-2;
  }
</style>
