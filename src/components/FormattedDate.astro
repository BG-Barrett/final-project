---
const { date, ...rest } = Astro.props;
---

<time datetime={new Date(date).toISOString()} {...rest}>
  <time datetime={date.toISOString()}>
    {new Date(date).toLocaleDateString("default", { day: "numeric" })}
    {new Date(date).toLocaleDateString("default", { month: "short" })},
    {new Date(date).getFullYear()}
  </time>
</time>

<style lang="scss">
  @use "../styles/abstracts" as *;

  time {
    color: $date-color;
  }
</style>
